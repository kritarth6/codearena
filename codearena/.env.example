# ==========================================
# CodeArena - Environment Variables Template
# ==========================================
# Copy this file to .env.local for local development.
# Configure these variables in your Vercel Project Settings for production.

# ------------------------------------------
# Firebase Client Configuration (Public)
# ------------------------------------------
# Obtain from Firebase Console > Project Settings > General > Your Apps (Web App)
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyExampleKeyPlaceholder123456789
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890abcdef

# ------------------------------------------
# Judge0 Code Execution Configuration (Server-Only)
# ------------------------------------------
# CRITICAL: Keep server-only. NEVER prefix with NEXT_PUBLIC_
# RapidAPI Judge0 CE Key: https://rapidapi.com/judge0-official/api/judge0-ce
JUDGE0_API_KEY=your_rapidapi_judge0_key_here
JUDGE0_API_HOST=judge0-ce.p.rapidapi.com
