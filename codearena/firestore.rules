rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to get current user record
    function currentUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    // Check if user has admin role
    function isAdmin() {
      return isAuthenticated() && currentUser().role == 'admin';
    }
    
    // Check if user has faculty or admin role
    function isFacultyOrAdmin() {
      return isAuthenticated() && (currentUser().role == 'faculty' || currentUser().role == 'admin');
    }

    // USERS COLLECTION
    match /users/{userId} {
      // Authenticated users can read profiles for leaderboards and directories
      allow read: if isAuthenticated();
      
      // Registration: A user can create their own profile with 'student' role, or Admin can provision
      allow create: if (isAuthenticated() &&
                      request.auth.uid == userId &&
                      request.resource.data.role == 'student' &&
                      request.resource.data.status == 'active')
                    || isAdmin();
                      
      // Users can update their own personal details, but CANNOT self-elevate roles or ratings
      allow update: if (isAuthenticated() && request.auth.uid == userId &&
                        request.resource.data.role == resource.data.role &&
                        request.resource.data.status == resource.data.status &&
                        request.resource.data.rating == resource.data.rating)
                    || isAdmin();
                    
      // Only admins can delete user documents
      allow delete: if isAdmin();
    }
    
    // CONTESTS COLLECTION
    match /contests/{contestId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isFacultyOrAdmin();
    }
    
    // PROBLEMS COLLECTION
    match /problems/{problemId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isFacultyOrAdmin();
    }
    
    // SUBMISSIONS COLLECTION
    match /submissions/{submissionId} {
      allow read: if isAuthenticated() && (
        resource.data.studentId == request.auth.uid || isFacultyOrAdmin()
      );
      
      allow create: if (isAuthenticated() && request.resource.data.studentId == request.auth.uid) || isAdmin();
      allow update, delete: if isAdmin();
    }
  }
}
